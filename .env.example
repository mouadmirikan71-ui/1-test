# Backey — environment reference.
#
# NEVER put a real key in this file. It is committed to Git on purpose and must
# stay a template. Real values go in your hosting platform's secret store.
#
#   Railway : service -> Variables
#   Render  : service -> Environment
#   Fly.io  : fly secrets set GEMINI_API_KEY=...
#   VPS     : an EnvironmentFile with mode 0600, referenced by systemd

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Google Gemini API key. Server-side only.
# The backend reads this at startup and holds it in memory; no endpoint ever
# returns any part of it. While this is set, POST and DELETE /api/key respond
# with 409, so the browser cannot override or exfiltrate the key.
GEMINI_API_KEY=

# `GOOGLE_API_KEY` is also accepted. If both are set, GOOGLE_API_KEY wins.

# ---------------------------------------------------------------------------
# OPTIONAL — every one of these has a safe default. Uncomment only to override.
# ---------------------------------------------------------------------------

# Port and bind address. Most platforms inject PORT automatically.
# PORT=8787
# HOST=0.0.0.0

# Model selection. Normally leave these UNSET: the server calls
# GET /v1beta/models and uses only models this key can actually run, so a stale
# or wrong id self-heals. Set these only to force a specific preference.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash

# Maximum simultaneous chat streams before new requests get a 429.
# BACKEY_MAX_CONCURRENT=6

# Write the key to data/gemini.key when it is saved through the Settings UI.
# Irrelevant when GEMINI_API_KEY is set (saving is refused with 409). Set to 0
# on a read-only or ephemeral filesystem.
# BACKEY_KEY_PERSIST=0

# Path of the key file, if persistence is enabled.
# BACKEY_KEY_FILE=/app/data/gemini.key

# Set to 1 ONLY for a backendless static host. It allows the browser to hold a
# key in localStorage. Leave unset (the default) whenever this backend runs.
# BACKEY_ALLOW_DIRECT=0

# Override the upstream base URL. For testing only — production must use the
# real endpoint, which is the default.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
